# Copy this file to .env and replace every change-me value.
COMPOSE_PROJECT_NAME=gapssa

# EspoCRM
ESPOCRM_IMAGE=espocrm/espocrm:10.0.3-apache-trixie
ESPOCRM_HTTP_PORT=8081
ESPOCRM_WEBSOCKET_PORT=8083
ESPOCRM_SITE_URL=http://localhost:8081
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=change-me-admin-password

# EspoCRM database
ESPOCRM_DB_IMAGE=mariadb:11.4
ESPOCRM_DB_NAME=espocrm
ESPOCRM_DB_USER=espocrm
ESPOCRM_DB_PASSWORD=change-me-database-password
ESPOCRM_DB_ROOT_PASSWORD=change-me-root-password

# Postgres (apps/web + Payload CMS) — Fase 1
# No reutiliza la MariaDB de EspoCRM. Un único servidor con tres bases de
# datos separadas (ver infra/postgres/README.md): gapssa_cms (POSTGRES_DB,
# creada automáticamente), gapssa_auth y gapssa_booking (creadas por
# infra/postgres/init/001-create-databases.sh).
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_HOST_PORT=5433
POSTGRES_DB=gapssa_cms
POSTGRES_USER=gapssa_apps
POSTGRES_PASSWORD=change-me-apps-db-password
# Nombres de las otras dos bases lógicas, creadas por
# infra/postgres/init/001-create-databases.sh la primera vez que se
# inicializa el volumen. Deben coincidir con el nombre de base en
# DATABASE_URL_AUTH/DATABASE_URL_BOOKING más abajo.
POSTGRES_AUTH_DB=gapssa_auth
POSTGRES_BOOKING_DB=gapssa_booking

# URLs de conexión completas, una por base de datos lógica (todas apuntan
# al mismo servidor apps-db, solo cambia el nombre de la base).
DATABASE_URL_CMS=postgresql://gapssa_apps:change-me-apps-db-password@localhost:5433/gapssa_cms
DATABASE_URL_AUTH=postgresql://gapssa_apps:change-me-apps-db-password@localhost:5433/gapssa_auth
DATABASE_URL_BOOKING=postgresql://gapssa_apps:change-me-apps-db-password@localhost:5433/gapssa_booking

# Redis (locks, OTP, idempotencia, rate limiting) — Fase 1
REDIS_IMAGE=redis:8-alpine
REDIS_HOST_PORT=6380
REDIS_PASSWORD=change-me-redis-password
# Prefijo de claves por entorno — evita colisiones si algún día se comparte
# una instancia de Redis entre entornos. Namespaces previstos (Fase 4, no
# usados todavía): lock:, otp:, idempotency:, rate-limit:.
REDIS_KEY_PREFIX=gapssa:dev:
REDIS_URL=redis://:change-me-redis-password@localhost:6380

# apps/web — Fase 1
# Next.js: variables sin prefijo NEXT_PUBLIC_ nunca llegan al navegador.
PAYLOAD_SECRET=change-me-payload-secret-min-32-chars
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# apps/web — Fase 2 (web pública)
# "true" bloquea la indexación de todo el sitio vía robots.txt — pensado
# para staging/desarrollo, nunca para producción. Cualquier otro valor
# (incluida la variable ausente) se trata como "false".
SITE_NOINDEX=false
# Umami: ambas vacías por defecto — "preparado, pero sin activar"
# (PLAN_DESARROLLO_WEB_PORTAL.md §16). Sin las dos, AnalyticsScript no
# renderiza ningún <script> ni hace petición alguna.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=

# apps/web — Fase 3 (autenticación del portal, gapssa_auth)
# Secreto del HMAC de códigos OTP (packages/contracts/src/otp.ts). SIN
# valor por defecto en código — genera el tuyo (p. ej.
# `openssl rand -base64 32`) y nunca reutilices el mismo valor entre
# entornos. Distinto de PAYLOAD_SECRET.
OTP_HMAC_SECRET=change-me-otp-hmac-secret-min-32-chars
# Secreto del HMAC de identificadores de sujeto derivados de correo usados
# en claves de Redis de límite de frecuencia (server/auth/security ->
# @gapssa/contracts hmacSubjectId). Distinto de OTP_HMAC_SECRET — genera el
# tuyo aparte, nunca reutilices el mismo valor. Rotarlo "olvida" cualquier
# ventana de límite de frecuencia activa (efecto documentado, no un fallo).
AUTH_RATE_LIMIT_HMAC_SECRET=change-me-rate-limit-hmac-secret-min-32-chars
# Saltos de proxy inverso de confianza delante de Next.js (Plesk/nginx,
# PROJECT_CONTEXT.md §15). 1 = un único proxy inmediatamente delante (la
# topología real de producción): getClientIp toma la ÚLTIMA entrada de
# X-Forwarded-For, la única que ese proxy pudo escribir. 0 = no confíes en
# ninguna cabecera X-Forwarded-For. Sube este número si se añade otro
# proxy/CDN por delante de Plesk; nunca lo bajes sin que la topología real
# cambie.
TRUSTED_PROXY_HOP_COUNT=1
# Valores técnicos sugeridos, pendientes de confirmación explícita
# (docs/fase3-autenticacion.md) — configurables sin desplegar código
# nuevo. Omitir cualquiera de estas cae al valor por defecto documentado
# en packages/contracts/src/{otp,auth}.ts.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=15
OTP_REQUEST_MAX_PER_SUBJECT_PER_HOUR=5
OTP_REQUEST_MAX_PER_IP_PER_HOUR=20
AUTH_SESSION_ABSOLUTE_TTL_DAYS=30
AUTH_PASSWORD_RESET_SESSION_MINUTES=10
AUTH_LOGIN_MAX_ATTEMPTS_PER_ACCOUNT_PER_HOUR=10
AUTH_LOGIN_MAX_ATTEMPTS_PER_IP_PER_HOUR=30
AUTH_LOGIN_LOCKOUT_MINUTES=15
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# SMTP operativo — credenciales reales pendientes de Gapssa
# (PLAN_DESARROLLO_WEB_PORTAL.md §21: "credenciales SMTP" en la lista de
# decisiones que no deben inventarse). Vacío: activa el transporte de
# desarrollo (apps/web/src/server/auth/mailer.ts) — nunca envía correo
# real, vuelca el contenido a la consola del servidor para poder probar
# el flujo localmente.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Remitente ya decidido por el plan (no es un secreto) — igualmente
# configurable, nunca hardcodeado en el código.
SMTP_FROM_EMAIL=reservas@gapssa.es

# apps/web — Fase 4A (reservas, gapssa_booking)
# Mapa JSON {"keyVersion": "claveBase64DE32Bytes"} para AES-256-GCM
# (server/crypto/fieldCrypto.ts, cifrado de PendingGuestIdentity). Genera
# tu propia clave, p. ej. `openssl rand -base64 32` — NUNCA reutilices el
# valor de ejemplo de abajo. Todas las versiones listadas siguen sirviendo
# para DESCIFRAR (rotación sin invalidar datos antiguos); solo
# BOOKING_FIELD_ENCRYPTION_ACTIVE_KEY_VERSION se usa para cifrar datos
# nuevos. Para rotar: añade una versión nueva al mapa, cambia
# BOOKING_FIELD_ENCRYPTION_ACTIVE_KEY_VERSION a esa versión y conserva la(s)
# anterior(es) en el mapa hasta que ya no quede ningún dato cifrado con
# ellas (PendingGuestIdentity se purga en pocos minutos/horas por diseño,
# así que la ventana de retención de una clave retirada es corta).
BOOKING_FIELD_ENCRYPTION_KEYS={"v1":"SMPjWaHD6TE00ATavtZnGRt49b9/mzLx6ekoMrbZzpU="}
BOOKING_FIELD_ENCRYPTION_ACTIVE_KEY_VERSION=v1
# HMAC del correo normalizado del invitado (emailLookupHmac) — secreto
# propio, distinto de OTP_HMAC_SECRET/AUTH_RATE_LIMIT_HMAC_SECRET. Mapa JSON
# {"keyVersion": "secreto"}, mismo patrón de rotación versionada que
# BOOKING_IDENTITY_FINGERPRINT_HMAC_SECRETS (server/booking/guestFlow.ts
# busca bajo todas las versiones presentes durante convivencia).
BOOKING_EMAIL_LOOKUP_HMAC_SECRETS={"v1":"SMPjWaHD6TE00ATavtZnGRt49b9/mzLx6ekoMrbZzpU="}
BOOKING_EMAIL_LOOKUP_HMAC_ACTIVE_KEY_VERSION=v1
# Revisión 2: mapa JSON {"keyVersion": "secreto"} para la huella HMAC-SHA-256
# de identidad/contacto (nombre/apellidos/correo/teléfono normalizados) que
# sustituye al correo en claro dentro del payload canónico de idempotencia
# (server/booking/identityFingerprint.ts). Mismo patrón de rotación que
# BOOKING_FIELD_ENCRYPTION_KEYS: cada BookingRequestRecord guarda con qué
# versión se calculó su huella, así que retirar una versión del mapa solo es
# seguro cuando ya no queda ningún BookingRequestRecord vivo que la use
# (como mucho APPROVAL_HOLD_HOURS tras dejar de ser la versión activa).
BOOKING_IDENTITY_FINGERPRINT_HMAC_SECRETS={"v1":"SMPjWaHD6TE00ATavtZnGRt49b9/mzLx6ekoMrbZzpU="}
BOOKING_IDENTITY_FINGERPRINT_ACTIVE_KEY_VERSION=v1
# HMAC del token de acceso opaco de una solicitud de invitado (sin sesión)
# — evita que se pueda consultar/verificar una solicitud ajena adivinando
# su id (UUID). Mapa JSON {"keyVersion": "secreto"} — cada solicitud
# guarda con qué versión se firmó su token (accessTokenKeyVersion);
# verificar usa siempre esa versión guardada, nunca "probar todas".
BOOKING_REQUEST_ACCESS_TOKEN_HMAC_SECRETS={"v1":"SMPjWaHD6TE00ATavtZnGRt49b9/mzLx6ekoMrbZzpU="}
BOOKING_REQUEST_ACCESS_TOKEN_HMAC_ACTIVE_KEY_VERSION=v1
# Secreto compartido de los endpoints internos de reservas (barrido de
# conciliación, decisión de aprobación simulada de EspoCRM) — cabecera
# X-Internal-Api-Secret. Nunca expuesto al navegador.
BOOKING_INTERNAL_API_SECRET=change-me-booking-internal-api-secret-min-32-chars
# Valor técnico sugerido (packages/contracts/src/booking.ts) — ventana de
# recuperación tras "verification_processing" antes de resolver
# "verification_expired" con reasonCode="RecoveryWindowExceeded".
BOOKING_VERIFICATION_RECOVERY_WINDOW_MINUTES=30
# Horario de apertura (PLAN_DESARROLLO_WEB_PORTAL.md): lunes a sábado
# (0=domingo..6=sábado), 09:00-21:00. Valor de negocio ya fijado, pero
# configurable sin desplegar código nuevo (server/booking/availabilityConfig.ts).
BOOKING_BUSINESS_DAYS=1,2,3,4,5,6
BOOKING_OPEN_TIME=09:00
BOOKING_CLOSE_TIME=21:00
# Granularidad de los huecos ofrecidos en la disponibilidad — valor técnico.
BOOKING_SLOT_GRANULARITY_MINUTES=15
# Tope de seguridad de huecos devueltos por una sola consulta de disponibilidad.
BOOKING_MAX_SLOTS_PER_QUERY=40
# Límites de frecuencia por IP de los endpoints de reservas — valores técnicos.
BOOKING_REQUEST_MAX_PER_IP_PER_HOUR=20
BOOKING_VERIFY_MAX_PER_IP_PER_HOUR=30
BOOKING_AVAILABILITY_MAX_PER_IP_PER_HOUR=120

# Fase 4B — selector EXPLÍCITO del adaptador de reservas contra EspoCRM.
# Por defecto "simulated": ningún entorno (incluidas las suites de
# pruebas) pasa a usar el adaptador HTTP real por accidente. "http" sin el
# resto de variables de esta sección completas hace fallar el arranque del
# proceso (nunca cae de vuelta al simulado en silencio).
ESPO_BOOKING_ADAPTER=simulated
# Solo si ESPO_BOOKING_ADAPTER=http. Desarrollo local: http://localhost:8081
# (apps/web corre con `next dev` en el host, no en un contenedor — no usar
# el hostname interno de Docker "espocrm"). Producción: https://crm.gapssa.es.
#ESPOCRM_API_BASE_URL=http://localhost:8081
# API Key de un API User de EspoCRM dedicado (nunca "admin" ni una cuenta
# humana) — cabecera X-Api-Key. Fase 4B, punto 10 (puerta 3): rol "Portal
# GAPSSA API" y User "portal-gapssa-api" (type=api, authMethod=ApiKey) ya
# creados en la instancia real; el valor real de la clave vive solo en el
# .env local ignorado por Git. Nunca commitear un valor real aquí.
#ESPOCRM_API_KEY=change-me
ESPOCRM_API_TIMEOUT_MS=8000
ESPOCRM_API_MAX_RETRIES=2
ESPOCRM_API_RETRY_BASE_DELAY_MS=200
ESPOCRM_API_MAX_RESPONSE_BYTES=2000000
# EspoCRM no tiene ningún campo/rol que marque un User como "profesional
# reservable" — lista blanca explícita de User.id de EspoCRM, separada por
# comas, en vez de adivinar un criterio (rol/equipo) no confirmado.
#ESPOCRM_PROFESSIONAL_USER_IDS=

