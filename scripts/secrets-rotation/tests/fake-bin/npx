#!/usr/bin/env bash
# `npx` falso — solo entiende el patrón que usa la puerta S7
# ("npx dotenv -e FILE -- npx tsx SCRIPT.mts") y el de 02-generate-secret.sh
# no lo usa (ese script llama a python3 directamente). Emite JSON canned
# según el nombre del script (.../preflight.*.mts vs .../migrate.*.mts) —
# nunca ejecuta TypeScript real, nunca toca una base de datos real.
set -euo pipefail

STATE="${FAKE_DOCKER_STATE:?FAKE_DOCKER_STATE no definido}"
TRANSCRIPT="${FAKE_DOCKER_TRANSCRIPT:?FAKE_DOCKER_TRANSCRIPT no definido}"

{
  printf 'NPX_ARGV:'
  for a in "$@"; do printf ' [%s]' "$a"; done
  printf '\n'
} >>"$TRANSCRIPT"

get_state() { cat "$STATE/$1" 2>/dev/null || printf '%s' "${2:-}"; }

script=""
for a in "$@"; do
  case "$a" in
  *.mts) script="$a" ;;
  esac
done

case "$script" in
*s7-preflight*)
  printf '%s\n' "$(get_state s7_preflight_json '{"liveRequests":0,"liveFingerprintV1V2":0,"activeGuestIdentities":0}')"
  exit 0
  ;;
*s7-migrate*)
  printf '{"fromVersion":"v1","guest":{},"auth":{}}\n'
  printf '%s\n' "$(get_state s7_migrate_json '{"remainingV1":0,"remainingV2":0}')"
  exit 0
  ;;
esac

exit 0
