{
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@payload-config": [
        "./src/payload.config.ts"
      ]
    },
    "target": "ES2022"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-integration-test/dev/types/**/*.ts",
    ".next-integration-test/dev/dev/types/**/*.ts",
    ".next-debug/types/**/*.ts",
    ".next-debug/dev/types/**/*.ts",
    ".next-decision-rehearsal2/types/**/*.ts",
    ".next-decision-rehearsal2/dev/types/**/*.ts",
    ".next-puerta5b1-probe/types/**/*.ts",
    ".next-puerta5b1-probe/dev/types/**/*.ts",
    ".next-puerta5b2b/types/**/*.ts",
    ".next-puerta5b2b/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
