{
  "name": "@gapssa/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:rotation-integration": "vitest run --config vitest.rotation-integration.config.ts",
    "test:e2e": "playwright test",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/index.ts",
    "auth:db:generate": "drizzle-kit generate --config drizzle.auth.config.ts",
    "auth:db:migrate": "tsx src/server/auth/db/migrate.ts",
    "booking:db:generate": "drizzle-kit generate --config drizzle.booking.config.ts",
    "booking:db:migrate": "tsx src/server/booking/db/migrate.ts"
  },
  "dependencies": {
    "@gapssa/contracts": "*",
    "@node-rs/argon2": "2.0.2",
    "@payloadcms/db-postgres": "3.87.0",
    "@payloadcms/next": "3.87.0",
    "@payloadcms/richtext-lexical": "3.87.0",
    "drizzle-orm": "0.45.2",
    "graphql": "16.14.2",
    "next": "16.3.0",
    "nodemailer": "9.0.4",
    "payload": "3.87.0",
    "pg": "8.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "6.2.0",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@payloadcms/ui": "3.87.0",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@types/mailparser": "^3.4.6",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/smtp-server": "^3.5.10",
    "@vitejs/plugin-react": "6.0.5",
    "cross-env": "10.1.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "29.1.1",
    "mailparser": "^3.9.14",
    "prettier": "3.9.6",
    "smtp-server": "^3.19.2",
    "tsx": "4.23.8",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
